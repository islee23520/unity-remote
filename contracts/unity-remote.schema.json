{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unity-remote.local/contracts/unity-remote.schema.json",
  "title": "Unity Remote protocol",
  "description": "Canonical v1 contract shared by the broker, web client, CLI, and Unity Editor connector. Wire identities are componentId and SerializedProperty.propertyPath.",
  "oneOf": [
    { "$ref": "#/$defs/projectSnapshot" },
    { "$ref": "#/$defs/objectSnapshot" },
    { "$ref": "#/$defs/editRequest" },
    { "$ref": "#/$defs/editPreview" },
    { "$ref": "#/$defs/editResult" },
    { "$ref": "#/$defs/saveRequest" },
    { "$ref": "#/$defs/saveResult" },
    { "$ref": "#/$defs/setActiveRequest" },
    { "$ref": "#/$defs/setActiveResult" },
    { "$ref": "#/$defs/inspectRequest" },
    { "$ref": "#/$defs/contextRequest" },
    { "$ref": "#/$defs/unityContext" },
    { "$ref": "#/$defs/protocolEvent" },
    { "$ref": "#/$defs/errorEnvelope" },
    { "$ref": "#/$defs/connectorHello" },
    { "$ref": "#/$defs/connectorRequest" },
    { "$ref": "#/$defs/connectorResponse" },
    { "$ref": "#/$defs/connectorEvent" },
    { "$ref": "#/$defs/playState" },
    { "$ref": "#/$defs/playModeRequest" },
    { "$ref": "#/$defs/gameViewFrame" },
    { "$ref": "#/$defs/gameInput" },
    { "$ref": "#/$defs/inputResult" }
  ],
  "$defs": {
    "scalarValue": {
      "type": ["string", "number", "boolean", "null"]
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "details"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "details": { "type": "object", "additionalProperties": true },
        "statusCode": { "type": "integer", "minimum": 400, "maximum": 599 }
      }
    },
    "errorEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["error"],
      "properties": {
        "error": { "$ref": "#/$defs/error" }
      }
    },
    "assetRoot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "path"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 }
      }
    },
    "projectSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "unityVersion", "connected", "source", "protocolVersion", "assetRoots"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "unityVersion": { "type": "string", "minLength": 1 },
        "connected": { "type": "boolean" },
        "source": { "enum": ["demo", "unity"] },
        "protocolVersion": { "const": 1 },
        "assetRoots": {
          "type": "array",
          "items": { "$ref": "#/$defs/assetRoot" }
        }
      }
    },
    "sceneSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "path", "loaded", "dirty", "revision"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "path": { "type": "string" },
        "loaded": { "type": "boolean" },
        "dirty": { "type": "boolean" },
        "revision": { "type": "integer", "minimum": 0 }
      }
    },
    "hierarchyNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "active", "children"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "active": { "type": "boolean" },
        "children": {
          "type": "array",
          "items": { "$ref": "#/$defs/hierarchyNode" }
        }
      }
    },
    "componentSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "properties", "editableProperties", "propertyDisplayNames"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 },
        "properties": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/scalarValue" }
        },
        "editableProperties": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "propertyDisplayNames": {
          "type": "object",
          "additionalProperties": { "type": "string", "minLength": 1 }
        }
      }
    },
    "objectSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sceneId", "name", "active", "revision", "components"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "sceneId": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "active": { "type": "boolean" },
        "revision": { "type": "integer", "minimum": 0 },
        "components": {
          "type": "array",
          "items": { "$ref": "#/$defs/componentSnapshot" }
        }
      }
    },
    "projectSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project", "scenes", "hierarchy"],
      "properties": {
        "project": { "$ref": "#/$defs/projectSummary" },
        "scenes": { "type": "array", "items": { "$ref": "#/$defs/sceneSummary" } },
        "hierarchy": { "type": "array", "items": { "$ref": "#/$defs/hierarchyNode" } }
      }
    },
    "editRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectId", "objectId", "componentId", "property", "value", "expectedRevision"],
      "properties": {
        "projectId": { "type": "string", "minLength": 1 },
        "objectId": { "type": "string", "minLength": 1 },
        "componentId": { "type": "string", "minLength": 1 },
        "property": { "type": "string", "minLength": 1 },
        "value": { "$ref": "#/$defs/scalarValue" },
        "expectedRevision": { "type": "integer", "minimum": 0 }
      }
    },
    "inspectRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["objectId"],
      "properties": {
        "projectId": { "type": "string", "minLength": 1 },
        "objectId": { "type": "string", "minLength": 1 }
      }
    },
    "contextRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "projectId": { "type": "string", "minLength": 1 },
        "objectIds": {
          "type": "array",
          "maxItems": 100,
          "items": { "type": "string", "minLength": 1, "maxLength": 256 }
        }
      }
    },
    "saveRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectId", "sceneId"],
      "properties": {
        "projectId": { "type": "string", "minLength": 1 },
        "sceneId": { "type": "string", "minLength": 1 }
      }
    },
    "setActiveRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectId", "objectId", "active", "expectedRevision"],
      "properties": {
        "projectId": { "type": "string", "minLength": 1 },
        "objectId": { "type": "string", "minLength": 1 },
        "active": { "type": "boolean" },
        "expectedRevision": { "type": "integer", "minimum": 0 }
      }
    },
    "editPreview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preview", "projectId", "objectId", "componentId", "property", "expectedRevision", "before", "after", "undoGroup"],
      "properties": {
        "preview": { "const": true },
        "projectId": { "type": "string", "minLength": 1 },
        "objectId": { "type": "string", "minLength": 1 },
        "componentId": { "type": "string", "minLength": 1 },
        "property": { "type": "string", "minLength": 1 },
        "expectedRevision": { "type": "integer", "minimum": 0 },
        "before": { "$ref": "#/$defs/scalarValue" },
        "after": { "$ref": "#/$defs/scalarValue" },
        "undoGroup": { "type": "string", "minLength": 1 }
      }
    },
    "editResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transactionId", "undoGroup", "object", "before", "after", "sceneDirty"],
      "properties": {
        "transactionId": { "type": "string", "minLength": 1 },
        "undoGroup": { "type": "string", "minLength": 1 },
        "object": { "$ref": "#/$defs/objectSnapshot" },
        "before": { "$ref": "#/$defs/scalarValue" },
        "after": { "$ref": "#/$defs/scalarValue" },
        "sceneDirty": { "type": "boolean" }
      }
    },
    "saveResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sceneId", "path", "dirty", "revision"],
      "properties": {
        "sceneId": { "type": "string", "minLength": 1 },
        "path": { "type": "string" },
        "dirty": { "const": false },
        "revision": { "type": "integer", "minimum": 0 }
      }
    },
    "setActiveResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["objectId", "active", "revision", "sceneDirty"],
      "properties": {
        "objectId": { "type": "string", "minLength": 1 },
        "active": { "type": "boolean" },
        "revision": { "type": "integer", "minimum": 0 },
        "sceneDirty": { "type": "boolean" }
      }
    },
    "unityContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "generatedAt", "project", "scenes", "hierarchy", "objects"],
      "properties": {
        "kind": { "const": "unity-project-context" },
        "generatedAt": { "type": "string", "minLength": 1 },
        "project": { "$ref": "#/$defs/projectSummary" },
        "scenes": { "type": "array", "items": { "$ref": "#/$defs/sceneSummary" } },
        "hierarchy": { "type": "array", "items": { "$ref": "#/$defs/hierarchyNode" } },
        "objects": { "type": "array", "items": { "$ref": "#/$defs/objectSnapshot" } }
      }
    },
    "protocolEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "projectId"],
      "properties": {
        "type": { "enum": ["hierarchyChanged", "propertyChanged", "connection", "sceneSaved", "playModeChanged"] },
        "projectId": { "type": "string", "minLength": 1 },
        "sceneId": { "type": "string" },
        "objectId": { "type": "string" },
        "revision": { "type": "integer", "minimum": 0 }
      }
    },
    "connectorHello": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "protocolVersion", "role", "token"],
      "properties": {
        "type": { "const": "hello" },
        "protocolVersion": { "const": 1 },
        "role": { "enum": ["unity", "events"] },
        "token": { "type": "string", "minLength": 1 }
      }
    },
    "connectorRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "method", "payload"],
      "properties": {
        "type": { "const": "request" },
        "id": { "type": "string", "minLength": 1 },
        "method": {
          "enum": ["getProjectSnapshot", "inspectObject", "applyEdit", "previewEdit", "createContext", "saveScene", "setActive", "getPlayState", "setPlayMode", "getGameViewFrame", "sendGameInput"]
        },
        "payload": true
      }
    },
    "connectorResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "ok"],
      "properties": {
        "type": { "const": "response" },
        "id": { "type": "string", "minLength": 1 },
        "ok": { "type": "boolean" },
        "payload": true,
        "error": { "$ref": "#/$defs/error" }
      }
    },
    "connectorEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "event"],
      "properties": {
        "type": { "const": "event" },
        "event": { "$ref": "#/$defs/protocolEvent" }
      }
    },
    "playState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["playing", "transitioning"],
      "properties": {
        "playing": { "type": "boolean" },
        "transitioning": { "type": "boolean" }
      }
    },
    "playModeRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["playing"],
      "properties": {
        "playing": { "type": "boolean" }
      }
    },
    "gameViewFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mimeType", "data", "width", "height"],
      "properties": {
        "mimeType": { "const": "image/jpeg" },
        "data": { "type": "string", "minLength": 1 },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      }
    },
    "gameInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "enum": ["keyDown", "keyUp", "mouseMove", "mouseDown", "mouseUp"] },
        "key": { "type": "string", "minLength": 1 },
        "button": { "type": "integer", "minimum": 0, "maximum": 2 },
        "x": { "type": "number", "minimum": 0, "maximum": 1 },
        "y": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "inputResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accepted"],
      "properties": {
        "accepted": { "const": true }
      }
    }
  }
}
